# --- Notion (CLI importer + app サーバー関数の両方が使う) ---
# Notion internal integration token。DB への insert + update 権限が必要
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# create-db が「Kindle 読書記録」DB を作る親ページの ID
NOTION_TARGET_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Turso (app のセッション DB + mind_map テーブル) ---
# libsql の接続 URL（例: libsql://<db>-<org>.turso.io）
TURSO_DATABASE_URL=libsql://xxxxxxxx.turso.io
# 上記 DB に対する読み書きトークン
TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Notion OAuth (app のログイン。上の integration token とは別物) ---
# Notion public integration の OAuth client id
NOTION_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 同 client secret
NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 単一ユーザー運用 ---
# このメールアドレスのアカウントだけがログインできる（未設定なら起動時に落ちる）
ALLOWED_NOTION_EMAIL=you@example.com

# --- better-auth ---
# セッション Cookie の署名鍵。`openssl rand -base64 32` 等で生成する
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
# アプリの公開 URL。OAuth コールバックと trustedOrigins の基準になる
BETTER_AUTH_URL=http://localhost:3000
# @better-auth/infra (dash プラグイン) の API キー
BETTER_AUTH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
